# Copy to .env (never commit it). Variable NAMES must match the *_env keys in config/accounts.yaml.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Container ---
TZ=Europe/Berlin            # schedule 07:30 is evaluated in this timezone
MAILFORGE_UID=1000          # owner of ./data and ./reports on the host (`id -u`)
MAILFORGE_GID=1000

# --- Delivery (SMTP example: Yahoo with an App Password) ---
REPORT_RECIPIENT_EMAIL=you@example.com
REPORT_SENDER_EMAIL=sender@example.com
YAHOO_APP_PASSWORD=your-yahoo-app-password

# --- Gmail account "gmail-1" (see scripts/get_oauth_token.py) ---
GMAIL_1_CLIENT_ID=
GMAIL_1_CLIENT_SECRET=
GMAIL_1_REFRESH_TOKEN=

# --- Outlook account "outlook-1" ---
OUTLOOK_1_CLIENT_ID=
OUTLOOK_1_REFRESH_TOKEN=

# --- Yahoo account "yahoo-1" (IMAP App Password, not your login password) ---
YAHOO_1_USERNAME=name@yahoo.com
YAHOO_1_APP_PASSWORD=
